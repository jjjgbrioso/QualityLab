# STAGING environment template. Do not put real values in this file.
# Set these in Vercel (Project > Settings > Environment Variables) or with `vercel env add`.
# To run migrations or seed from your PC, copy to .env.staging.local, which is git-ignored.

APP_ENV=staging

# Pooled connection string from your hosted PostgreSQL provider, used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED-HOST/DATABASE?sslmode=require

# Direct, non-pooled connection string, used only by Prisma migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=require

# Must be different from the LOCAL secret. Use at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters

JWT_EXPIRES_IN_SECONDS=7200
DUPLICATE_WINDOW_SECONDS=30
