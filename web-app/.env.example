# LOCAL environment template.
# Copy to .env.local, which is git-ignored:  Copy-Item .env.example .env.local
# Every value here is a placeholder or a local-only default. Never commit real secrets.

# Environment label reported by /api/v1/health: local or staging.
APP_ENV=local

# Connection string for the embedded PostgreSQL server started by `npm run db:start`.
DATABASE_URL=postgresql://qualitylab:qualitylab_local@127.0.0.1:5433/qualitylab_local

# Database used by `npm run test:integration`. It is wiped by those tests.
TEST_DATABASE_URL=postgresql://qualitylab:qualitylab_local@127.0.0.1:5433/qualitylab_test

# Signs login tokens. Use at least 32 random characters. To generate one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Login token lifetime in seconds.
JWT_EXPIRES_IN_SECONDS=7200

# Identical bank transactions inside this window are rejected. 0 turns the check off.
DUPLICATE_WINDOW_SECONDS=30
